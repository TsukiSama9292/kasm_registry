{
  "description": "ubuntu-noble-dind-rootless",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "docker-ubuntu.png",
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Quotas",
  "run_config": {
